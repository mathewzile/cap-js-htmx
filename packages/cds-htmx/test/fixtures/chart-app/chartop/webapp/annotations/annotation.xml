<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx" Version="4.0">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
  </edmx:Reference>
  <edmx:Reference Uri="/admin/$metadata">
    <edmx:Include Namespace="AdminService"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="local">
      <Annotations Target="AdminService.Authors">
        <Annotation Term="UI.Facets">
          <Collection>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="ID" String="Prices"/>
              <PropertyValue Property="Label" String="Prices"/>
              <PropertyValue Property="Target" AnnotationPath="books/@UI.Chart"/>
            </Record>
          </Collection>
        </Annotation>
      </Annotations>
      <Annotations Target="AdminService.Books">
        <Annotation Term="UI.Chart">
          <Record Type="UI.ChartDefinitionType">
            <PropertyValue Property="Title" String="Price per book"/>
            <PropertyValue Property="ChartType" EnumMember="UI.ChartType/Column"/>
            <PropertyValue Property="Dimensions">
              <Collection><PropertyPath>title</PropertyPath></Collection>
            </PropertyValue>
            <PropertyValue Property="Measures">
              <Collection><PropertyPath>price</PropertyPath><PropertyPath>stock</PropertyPath></Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
