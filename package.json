{
  "name": "cap-js-htmx",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "app/*"
  ],
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4.15.0",
    "cds-htmx": "*"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@playwright/test": "^1.64.1",
    "@sap/approuter": "^23.3.0",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "node-html-parser": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "node --env-file=packages/cds-htmx/test/test.env --test \"packages/cds-htmx/test/**/*.test.js\"",
    "test:e2e": "playwright test -c packages/cds-htmx/test/e2e/playwright.config.js",
    "test:visual": "playwright test -c packages/cds-htmx/test/e2e/visual.config.js",
    "docs:screenshots": "playwright test -c packages/cds-htmx/test/e2e/docs.config.js",
    "lint": "eslint packages/cds-htmx/lib packages/cds-htmx-shell",
    "watch-manage-books": "cds watch --open managebooks/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-browse-genres": "cds watch --open browsegenres/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-manage-authors": "cds watch --open manageauthors/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build:htmx-app": "npm run build --workspace=managebooks-htmx --workspace=manageauthors-htmx",
    "build:mta": "mbt build -t ./"
  },
  "sapux": [
    "app/manage-books",
    "app/browse-genres",
    "app/manage-authors"
  ],
  "cds": {
    "requires": {
      "db": {
        "[production]": {
          "kind": "hana"
        }
      },
      "auth": {
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    },
    "htmx": {
      "theme": "auto"
    }
  }
}
